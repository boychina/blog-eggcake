{
  "name": "blog-eggcake",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --webpack",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests configured\"",
    "build": "next build --webpack",
    "start": "next start",
    "export": "NEXT_OUTPUT_MODE=export NEXT_BASE_PATH=/docs next build --webpack && rm -rf docs && mv out docs",
    "site": "tsx scripts/site.ts",
    "fix:image-paths": "tsx scripts/fix-image-paths.ts",
    "organize:posts": "tsx scripts/organize-posts.ts"
  },
  "dependencies": {
    "antd": "^6.3.3",
    "@ant-design/icons": "^6.1.0",
    "classnames": "2.5.1",
    "d3-cloud": "^1.2.9",
    "dayjs": "^1.11.20",
    "github-markdown-css": "^5.9.0",
    "gray-matter": "4.0.3",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.0.0",
    "lodash": "^4.17.23",
    "markdown-it": "^14.1.1",
    "next": "^16.2.0",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.2",
    "postcss-preset-env": "11.2.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
